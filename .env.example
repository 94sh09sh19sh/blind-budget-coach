# Copy this file to .env.development.local (read by `npm run dev`) and to .env.production.local (read by `npm run build`).
# Both *.local files are listed in .gitignore. Do not commit them.
#
# Fill in the values that the Firebase console shows under Project settings > Your apps > SDK setup and configuration.
# While any of the six VITE_FIREBASE_* values is empty or REPLACE_ME, the app treats the cloud as not configured:
# it classifies on this device (or with local keyword rules) and makes no cloud request at all.
# The values below are fake placeholders.
VITE_FIREBASE_API_KEY=REPLACE_ME
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_ME
VITE_FIREBASE_PROJECT_ID=REPLACE_ME
VITE_FIREBASE_STORAGE_BUCKET=REPLACE_ME
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_ME
VITE_FIREBASE_APP_ID=REPLACE_ME

# App Check. Needed only when the Firebase project enforces App Check for Firebase AI Logic. Leave both empty otherwise.
#
# Production: the site key of a reCAPTCHA Enterprise key. It is a public value. Put it in .env.production.local only.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Local development: a debug token created in the Firebase console under App Check > Apps > Manage debug tokens.
# This one is a secret. Put it in .env.development.local only. The app reads it in dev mode only.
VITE_APPCHECK_DEBUG_TOKEN=
