# 複製成 .env.development.local（npm run dev 用）與 .env.production.local（npm run build 用），填入 Firebase 主控台「專案設定 > 您的應用程式」顯示的值。
# 兩個 .local 檔都被 .gitignore 排除，不會進 repo。全部留空時，app 只跑裝置端與本機規則，雲端功能停用。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check（專案對 Firebase AI Logic 強制 App Check 時需要）
# 正式站：reCAPTCHA Enterprise 的 site key（公開值），只放 .env.production.local
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# 本機開發：Firebase 主控台 App Check > Apps > Manage debug tokens 產生的權杖（祕密），只放 .env.development.local
VITE_APPCHECK_DEBUG_TOKEN=
